                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/lotes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoLote\": \"L-2026-001\",\n  \"fechaFabricacion\": \"2026-09-20\",\n  \"volumenProducido\": 250.00,\n  \"estado\": \"EN_PROCESO\",\n  \"usuarioId\": {{usuario_id}},\n  \"insumoId\": {{insumo_id}}\n}"
            }
          }
        },
        {
          "name": "Actualizar lote",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/lotes/{{lote_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoLote\": \"L-2026-001\",\n  \"fechaFabricacion\": \"2026-09-20\",\n  \"volumenProducido\": 260.00,\n  \"estado\": \"FINALIZADO\",\n  \"usuarioId\": {{usuario_id}},\n  \"insumoId\": {{insumo_id}}\n}"
            }
          }
        },
        {
          "name": "Eliminar lote",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/lotes/{{lote_id}}"
          }
        },
        {
          "name": "Lote nuevo como AUDITADO (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/lotes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoLote\": \"LOT-AUD-POSTMAN\",\n  \"fechaFabricacion\": \"2026-11-01\",\n  \"volumenProducido\": 100,\n  \"estado\": \"AUDITADO\",\n  \"usuarioId\": {{usuario_id}},\n  \"insumoId\": {{insumo_id}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responde 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Residuos Industriales",
      "item": [
        {
          "name": "Listar residuos",
          "request": {
