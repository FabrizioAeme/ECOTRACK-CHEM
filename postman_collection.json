          }
        },
        {
          "name": "Recogida especial sin certificado (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/residuos",
            "body": {
